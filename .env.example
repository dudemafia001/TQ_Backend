# Backend Environment Variables
# Copy this file to .env and update the values according to your deployment environment

# Server Configuration
NODE_ENV=production
PORT=5001

# Database Configuration
MONGO_URI=mongodb://localhost:27017/the-quisine-app

# CORS Configuration - Frontend URLs (comma-separated)
# For local development: http://localhost:3000,http://localhost:3001
# For production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# Payment Configuration - Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# SMS/OTP Configuration (if using SMS service)
SMS_API_KEY=your-sms-api-key

# Email Configuration (if using email service)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-app-password

# File Upload Configuration
MAX_FILE_SIZE=5mb
UPLOAD_DIR=uploads

# API Rate Limiting (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration (optional)
LOG_LEVEL=info
LOG_FILE=logs/app.log